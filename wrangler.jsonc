{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gohaeso",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  // Static site lives in ./public. Only /ws/* and /api/* reach the Worker first; everything else is served as a file.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws/*", "/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "MAILROOM", "class_name": "Mailroom" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Mailroom"] }
  ],
  // The real address. Visitors who arrive on the old *.workers.dev address are sent here, so a mailbox key is never split across two addresses.
  "vars": { "CANONICAL_HOST": "gohaeso.space" },
  // No request logs are collected: this service promises not to keep traces of visitors.
  "observability": { "enabled": false }
  // Secrets (set in the Cloudflare dashboard, never in git):
  //   MASTER_KEY  required. 32+ random characters:  openssl rand -hex 32
  //   ADMIN_TOKEN optional. 24+ random characters. Lets the operator read reported items only.
}
